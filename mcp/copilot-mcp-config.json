{
  "mcpServers": {
    "XcodeBuildMCP": {
      "type": "local",
      "command": "npx",
      "args": ["-y", "xcodebuildmcp@latest"],
      "tools": ["*"],
      "env": {
        "INCREMENTAL_BUILDS_ENABLED": "false",
        "SENTRY_DISABLED": "true",
        "XCODEBUILDMCP_SENTRY_DISABLED": "true"
      }
    },
    "proxyman": {
      "type": "local",
      "command": "/Applications/Proxyman.app/Contents/MacOS/mcp-server",
      "args": [],
      "tools": ["*"]
    }
  }
}
